# Server
PORT=3000
NODE_ENV=development

# Supabase — auth handled by Supabase Auth (email/password + Google OAuth).
# Backend verifies the user's access token via auth.getUser (service-role key)
# and uses the service-role key for writes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# CORS — allowlist of frontend origins (comma-separated). Add the LAN IP / prod
# domain the app is actually served from, otherwise iOS Safari / the PWA get
# blocked ("impossibile caricare i bar"). "*" allows any origin: dev-only,
# never in production — it lets any website drive the API from the browser.
# Su Vercel va impostata nelle Environment Variables del progetto: le preview
# hanno un sottodominio diverso a ogni deploy, quindi o si elencano quelli che
# servono o si tiene solo il dominio di produzione (le preview restano bloccate).
# Example: http://localhost:5173,https://rabar.vercel.app
FRONTEND_URL=http://localhost:5173

# Rate limiting (per IP, fixed window). GLOBAL_MAX guards every route; the
# public POST /suggestions has its own stricter 5/min limit in code.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120

# Cache su disco dei risultati Overpass. Vuoto = ./.cache/nearby.json in locale
# e /tmp/rabar-nearby.json su Vercel (unico path scrivibile). Best-effort: se la
# scrittura fallisce la cache resta in memoria.
NEARBY_CACHE_FILE=

# OpenStreetMap data sources (free, no key). Defaults shown; override only if
# you self-host Overpass/Nominatim. Set a real contact in the User-Agent.
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=rabar/1.0 (contact: your-email@example.com)

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Missing keys = push disabled, notifications stay in-app only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Stripe boosts (sponsorizzazioni). Test keys from dashboard.stripe.com.
# Missing secret = POST /boosts/checkout returns 503, everything else works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOST_PRICE_3D_CENTS=300
BOOST_PRICE_7D_CENTS=600
BOOST_PRICE_30D_CENTS=2000

# rabar+ (abbonamento: badge "+", tutti i temi, niente pubblicità).
# Stessa STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET dei boost. Il webhook deve
# ricevere anche: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed.
# Prezzi in centesimi (usati solo se il Price id corrispondente è vuoto).
PLUS_PRICE_WEEK_CENTS=199
PLUS_PRICE_MONTH_CENTS=399
PLUS_PRICE_YEAR_CENTS=2999
# Opzionali: id dei Price ricorrenti creati in dashboard (price_...). Se
# valorizzati vincono sul prezzo inline e i ricavi finiscono sotto un Product solo.
STRIPE_PLUS_PRICE_WEEK=
STRIPE_PLUS_PRICE_MONTH=
STRIPE_PLUS_PRICE_YEAR=
